{
    "version": 6,
    "configurePresets": [
        {
            "name": "common",
            "warnings": {
                "deprecated": false,
                "uninitialized": true
            },
            "errors": {
                "dev": true
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
                "BUILD_TESTING": "ON",
                "DEBUG_MESSAGES": "0"
            }
        },
        {
            "name": "debug",
            "inherits": "common",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-verbose",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/debug-verbose",
            "cacheVariables": {
                "DEBUG_MESSAGES": "1"
            }
        },
        {
            "name": "release",
            "inherits": "common",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
            },
            "warnings": {
                "deprecated": false
            }
        },
        {
            "name": "release-syms",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/release-syms",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "jobs": 0
        },
        {
            "name": "debug-verbose",
            "configurePreset": "debug-verbose",
            "jobs": 0
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "environment": {
                "LD_LIBRARY_PATH": "${sourceDirName}"
            },
            "output": {
              "outputOnFailure": true
            },
            "execution": {
              "noTestsAction": "error",
              "stopOnFailure": true
            }
        },
        {
            "name": "debug-verbose",
            "inherits": "debug",
            "configurePreset": "debug-verbose"
        }
    ],
    "workflowPresets": [
        {
            "name": "debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                },
                {
                    "type": "test",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "debug-verbose",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug-verbose"
                },
                {
                    "type": "build",
                    "name": "debug-verbose"
                },
                {
                    "type": "test",
                    "name": "debug-verbose"
                }
            ]
        }
    ]
}
