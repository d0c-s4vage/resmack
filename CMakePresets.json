{
    "version": 6,
    "configurePresets": [
        {
            "name": "common",
            "warnings": {
                "deprecated": false
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
                "BUILD_TESTING": "ON"
            }
        },

        {
            "name": "debug",
            "inherits": [ "common" ],
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": [ "common" ],
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
            },
            "warnings": {
                "deprecated": false
            }
        },
        {
            "name": "release-syms",
            "inherits": [ "release" ],
            "binaryDir": "${sourceDir}/build/release-syms",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },

        {
            "name": "default",
            "inherits": [ "debug" ]
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "jobs": 0
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "environment": {
                "LD_LIBRARY_PATH": "${sourceDirName}"
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "debug-workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "default"
                },
                {
                    "type": "test",
                    "name": "default"
                }
            ]
        }
    ]
}
