#ifndef RESMACK_DEBUG_H
#define RESMACK_DEBUG_H

#include <iostream>
#include <source_location>

#cmakedefine DEBUG_MESSAGES @DEBUG_MESSAGES@

#define _DEBUG_PRINT(...) \
  printf("[[DEBUG]] [%s] ", std::source_location::current().function_name()); \
  printf(__VA_ARGS__); \
  std::cout << std::flush;

#if DEBUG_MESSAGES
#define DEBUG_PRINT(...) _DEBUG_PRINT(__VA_ARGS__)
#else
#define DEBUG_PRINT(...)
#endif

#endif
